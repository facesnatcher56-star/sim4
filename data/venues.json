      "grocery_cooler": {"clone": "fridge", "override": {"label": "Grocery Cooler", "price": 700, "tags": ["food", "shop", "appliance", "market"],
        "color": "#9fd0e6", "height": 1.8, "interactions": ["buy_groceries", "buy_fresh_snack"],
        "state": {"stock": {"min": 0, "max": 40, "start": 40}, "broken": {"start": false}},
        "advertises": {"hunger": 1.5}}}
    },
    "interactions": {
      "order_coffee": {"label": "Order Coffee", "kind": "super", "target": "object", "objects": ["cafe_counter"], "duration_min": 4, "posture": "stand",
        "tags": ["drink", "purchase", "shop", "social", "cafe"],
        "tests": [{"coins_at_least": 4}, {"stat_below": ["energy", 85]}],
        "per_min": {"energy": 6.0, "fun": 0.6, "social": 0.5},
        "on_finish": [{"coins_add": -4}, {"add_buff": "cozy"}, {"stat_add": ["social", 3]}],
        "autonomous": true, "priority": "normal", "advertises": {"energy": 2.0, "social": 0.6},
        "thought": "A coffee would be lovely.", "cooldown_min": 120},
      "order_meal": {"label": "Order a Meal", "kind": "super", "target": "object", "objects": ["cafe_counter"], "duration_min": 12, "posture": "stand",
        "tags": ["food", "meal", "purchase", "shop", "cafe"],
        "tests": [{"coins_at_least": 12}, {"stat_below": ["hunger", 55]}],
        "per_min": {"hunger": 6.5, "fun": 0.3},
        "on_finish": [{"coins_add": -12}, {"add_buff": "well_fed"}],
        "autonomous": true, "priority": "normal", "advertises": {"hunger": 2.6},
        "thought": "Something hot to eat, please.", "cooldown_min": 180},
      "order_round": {"label": "Order a Round", "kind": "super", "target": "object", "objects": ["cafe_counter"], "duration_min": 8, "posture": "stand",
        "tags": ["drink", "purchase", "shop", "social", "night"],
        "tests": [{"coins_at_least": 6}, {"time_between": [17, 24]}, {"stat_below": ["fun", 85]}],
        "per_min": {"fun": 2.2, "social": 1.4},
        "on_finish": [{"coins_add": -6}, {"chance": 0.4, "add_buff": "social_glow"}],
        "autonomous": true, "priority": "normal", "advertises": {"fun": 2.2, "social": 1.2},
        "thought": "Cheers!", "cooldown_min": 150},
      "buy_groceries": {"label": "Buy Groceries", "kind": "super", "target": "object", "objects": ["grocery_cooler"], "duration_min": 6, "posture": "stand",
        "tags": ["purchase", "shop", "chore", "food"],
        "tests": [{"coins_at_least": 25}],
        "on_finish": [{"coins_add": -25}, {"fire_event": "buy_groceries"}, {"notify": "Groceries bought. They will be stocked in the home fridge."}],
        "autonomous": false, "priority": "normal", "thought": "Stocking up."},
      "buy_fresh_snack": {"label": "Grab a Fresh Snack", "kind": "super", "target": "object", "objects": ["grocery_cooler"], "duration_min": 3, "posture": "stand",
        "tags": ["food", "snack", "purchase", "shop"],
        "tests": [{"coins_at_least": 5}, {"stat_below": ["hunger", 70]}, {"object_state_above": ["stock", 0]}],
        "per_min": {"hunger": 11.0},
        "on_finish": [{"coins_add": -5}, {"object_state_add": ["stock", -1]}, {"stat_add": ["fun", 2]}],
        "autonomous": true, "priority": "normal", "advertises": {"hunger": 2.0},
        "thought": "Something fresh.", "cooldown_min": 60},
