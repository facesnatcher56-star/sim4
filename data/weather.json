{
  "version": 1,
  "notes": "Weather model for scripts/systems/weather.gd. A deterministic Markov chain steps every settings.step_hours game hours. P(next | prev, season) ~ seasons[season].weights[next] * follow[prev][next]; weathers absent from a season's weights can never occur in it. Content (buffs / interactions / whims) is injected at runtime by weather_content.gd. Temperatures are degrees Celsius.",
  "settings": {
    "step_hours": 4,
    "default_seed": 1337,
    "peak_hour": 15.0,
    "daily_noise": 2.0,
    "blend_minutes": 120,
    "min_temp": -30.0,
    "max_temp": 55.0,
    "wind_chill_per_wind": 3.0
  },
  "weathers": {
    "sunny": {"label": "Sunny", "icon": "sun", "severity": 1, "temp_offset": 2.0, "precip": 0.0, "kind": "", "light": 1.0, "cloud": 0.08, "fog": 0.0, "wind": 0.15, "walk_speed": 1.0,
      "sky": "#6fb4f0", "markers": ["wx_clear"], "outdoor_per_min": {}},
    "cloudy": {"label": "Cloudy", "icon": "cloud", "severity": 2, "temp_offset": -1.0, "precip": 0.0, "kind": "", "light": 0.68, "cloud": 0.75, "fog": 0.0, "wind": 0.25, "walk_speed": 1.0,
      "sky": "#8e9cab", "markers": [], "outdoor_per_min": {}},
    "rain": {"label": "Rain", "icon": "rain", "severity": 5, "temp_offset": -3.0, "precip": 0.7, "kind": "rain", "light": 0.5, "cloud": 0.95, "fog": 0.1, "wind": 0.35, "walk_speed": 0.97,
      "sky": "#5f6e7d", "markers": ["wx_wet"], "outdoor_per_min": {"hygiene": -0.12, "comfort": -0.04}},
    "thunderstorm": {"label": "Thunderstorm", "icon": "storm", "severity": 8, "temp_offset": -2.0, "precip": 1.0, "kind": "rain", "light": 0.3, "cloud": 1.0, "fog": 0.12, "wind": 0.8, "walk_speed": 0.92,
      "sky": "#394350", "markers": ["wx_wet", "wx_severe"], "outdoor_per_min": {"hygiene": -0.2, "comfort": -0.1}},
    "fog": {"label": "Fog", "icon": "fog", "severity": 3, "temp_offset": -2.0, "precip": 0.0, "kind": "", "light": 0.6, "cloud": 0.6, "fog": 0.85, "wind": 0.05, "walk_speed": 1.0,
      "sky": "#b4bcc2", "markers": [], "outdoor_per_min": {}},
    "snow": {"label": "Snow", "icon": "snow", "severity": 6, "temp_offset": -4.0, "precip": 0.6, "kind": "snow", "light": 0.72, "cloud": 0.9, "fog": 0.2, "wind": 0.2, "walk_speed": 0.85,
      "sky": "#aab6c4", "markers": ["wx_wet"], "outdoor_per_min": {"comfort": -0.06}},
    "heatwave": {"label": "Heatwave", "icon": "heat", "severity": 7, "temp_offset": 9.0, "precip": 0.0, "kind": "", "light": 1.05, "cloud": 0.0, "fog": 0.0, "wind": 0.05, "walk_speed": 0.95,
      "sky": "#8cc3ee", "tint": "#ffd9a8", "markers": ["wx_clear", "wx_hot"], "outdoor_per_min": {"energy": -0.04, "comfort": -0.06}},
    "cold_snap": {"label": "Cold Snap", "icon": "cold", "severity": 7, "temp_offset": -9.0, "precip": 0.0, "kind": "", "light": 0.9, "cloud": 0.3, "fog": 0.0, "wind": 0.3, "walk_speed": 0.95,
      "sky": "#9fc4e6", "tint": "#cfe3ff", "markers": ["wx_clear", "wx_cold"], "outdoor_per_min": {"comfort": -0.08}},
    "windy": {"label": "Windy", "icon": "wind", "severity": 4, "temp_offset": -2.0, "precip": 0.0, "kind": "", "light": 0.85, "cloud": 0.5, "fog": 0.0, "wind": 0.95, "walk_speed": 0.97,
      "sky": "#86a8c8", "markers": [], "outdoor_per_min": {"comfort": -0.03}}
  },
  "follow": {
    "sunny":        {"sunny": 1.8, "cloudy": 1.0, "rain": 0.4, "thunderstorm": 0.25, "fog": 0.5, "snow": 0.3, "heatwave": 1.2, "cold_snap": 0.5, "windy": 0.9},
    "cloudy":       {"sunny": 1.0, "cloudy": 1.6, "rain": 1.6, "thunderstorm": 1.0, "fog": 1.0, "snow": 1.6, "heatwave": 0.2, "cold_snap": 0.6, "windy": 1.2},
    "rain":         {"sunny": 0.5, "cloudy": 1.4, "rain": 2.0, "thunderstorm": 1.8, "fog": 1.2, "snow": 0.5, "heatwave": 0.05, "cold_snap": 0.3, "windy": 1.0},
    "thunderstorm": {"sunny": 0.4, "cloudy": 1.4, "rain": 3.0, "thunderstorm": 1.3, "fog": 0.6, "snow": 0.2, "heatwave": 0.05, "cold_snap": 0.2, "windy": 1.2},
    "fog":          {"sunny": 1.6, "cloudy": 1.6, "rain": 0.9, "thunderstorm": 0.2, "fog": 1.4, "snow": 0.8, "heatwave": 0.1, "cold_snap": 0.6, "windy": 0.6},
    "snow":         {"sunny": 0.5, "cloudy": 1.6, "rain": 0.2, "thunderstorm": 0.0, "fog": 1.0, "snow": 2.6, "heatwave": 0.0, "cold_snap": 1.4, "windy": 0.8},
    "heatwave":     {"sunny": 1.4, "cloudy": 0.6, "rain": 0.3, "thunderstorm": 1.6, "fog": 0.1, "snow": 0.0, "heatwave": 3.0, "cold_snap": 0.0, "windy": 0.6},
    "cold_snap":    {"sunny": 1.2, "cloudy": 1.0, "rain": 0.2, "thunderstorm": 0.0, "fog": 0.8, "snow": 1.8, "heatwave": 0.0, "cold_snap": 3.0, "windy": 1.2},
    "windy":        {"sunny": 1.2, "cloudy": 1.5, "rain": 1.2, "thunderstorm": 1.0, "fog": 0.3, "snow": 0.8, "heatwave": 0.2, "cold_snap": 1.0, "windy": 1.5}
  },
  "seasons": {
    "spring": {"weights": {"sunny": 4.0, "cloudy": 3.0, "rain": 3.2, "thunderstorm": 0.7, "fog": 0.8, "windy": 1.3}, "start": "sunny"},
    "summer": {"weights": {"sunny": 6.0, "cloudy": 2.0, "rain": 1.2, "thunderstorm": 1.0, "heatwave": 1.5, "windy": 0.5}, "start": "sunny"},
    "autumn": {"weights": {"sunny": 2.5, "cloudy": 3.5, "rain": 3.0, "thunderstorm": 0.3, "fog": 1.6, "windy": 2.0, "cold_snap": 0.5}, "start": "cloudy"},
    "winter": {"weights": {"sunny": 1.5, "cloudy": 3.0, "snow": 3.4, "fog": 0.8, "cold_snap": 1.8, "windy": 1.0}, "start": "cloudy"}
  },
  "effects": {
    "cold_temp": 5.0,
    "freezing_temp": -4.0,
    "hot_temp": 29.0,
    "frost_temp": 0.0,
    "cold_exposure_min": 12,
    "hot_exposure_min": 15,
    "sunburn_exposure_min": 120,
    "soak_exposure_min": 8,
    "fresh_air_exposure_min": 30,
    "fresh_air_temp": [10.0, 27.0],
    "cozy_chance_per_hour": 0.3,
    "indoor_dry_extra_min": 2.0,
    "indoor_warm_extra_min": 2.0,
    "snow_per_hour": 0.12,
    "snow_melt_per_hour": 0.04,
    "snow_melt_temp": 1.0,
    "wet_per_hour": 0.35,
    "dry_per_hour": 0.15,
    "puddle": {"max": 10, "per_hour": 2, "amount": 0.9, "dry_chance": 0.5},
    "lightning": {"per_hour_chance": 0.1, "break_tags": ["electronics"], "break_chance": 0.45},
    "garden": {"rain_water_per_hour": 0.6, "plant_rain_water_per_hour": 0.8, "rain_growth_mult_per_hour": 0.04, "heat_extra_dry": 1.0, "frost_kills": true},
    "bills": {"heat_below": 16.0, "cool_above": 22.0, "per_degree": 0.012, "max_mult": 1.5},
    "fishing": {"rain_bonus_coins": 8, "rain_extra_catch_chance": 0.3, "extra_coins": 14, "interactions": ["fish_pond", "fish_deep_water"]},
    "outdoor_patch": {"tag": "outdoor", "block_marker": "wx_severe", "mark": "_wx_patch"}
  },
  "buffs": {
    "cold": {"label": "Cold", "mood": {"uncomfortable": 2}, "duration_min": 120, "need_decay_mult": {"comfort": 1.5, "energy": 1.1}, "autonomy_mult": {"tag:fire": 1.6, "interaction:warm_by_fire": 1.5, "interaction:light_fireplace": 1.6}, "thought": "Brr, I'm freezing."},
    "hot": {"label": "Overheated", "mood": {"uncomfortable": 2}, "duration_min": 120, "need_decay_mult": {"hygiene": 1.4, "energy": 1.2}, "autonomy_mult": {"interaction:take_shower": 1.3}, "thought": "It's sweltering out here."},
    "soaked": {"label": "Soaked", "mood": {"uncomfortable": 2}, "duration_min": 90, "need_decay_mult": {"comfort": 1.4}, "autonomy_mult": {"interaction:take_shower": 1.4, "interaction:warm_by_fire": 1.4}, "thought": "I'm drenched."},
    "sunburn": {"label": "Sunburnt", "mood": {"uncomfortable": 1}, "duration_min": 600, "need_decay_mult": {"comfort": 1.2}, "thought": "Ouch, that's a sunburn."},
    "fresh_air": {"label": "Fresh Air", "mood": {"happy": 1, "energized": 1}, "duration_min": 360, "need_decay_mult": {"energy": 0.92}, "thought": "Nothing like fresh air."},
    "wx_clear": {"label": "Clear Skies", "mood": {}, "duration_min": 0, "hidden": true, "autonomy_mult": {"tag:outdoor": 1.25, "interaction:sunbathe": 1.4}},
    "wx_wet": {"label": "Wet Weather", "mood": {}, "duration_min": 0, "hidden": true, "autonomy_mult": {"tag:outdoor": 0.45, "interaction:watch_tv": 1.2, "tag:comfy": 1.25, "tag:relax": 1.15}},
    "wx_severe": {"label": "Severe Weather", "mood": {}, "duration_min": 0, "hidden": true, "autonomy_mult": {"tag:outdoor": 0.3, "tag:comfy": 1.2}},
    "wx_hot": {"label": "Heat", "mood": {}, "duration_min": 0, "hidden": true, "autonomy_mult": {"tag:fire": 0.3, "interaction:soak_hot_tub": 0.4}},
    "wx_cold": {"label": "Freezing", "mood": {}, "duration_min": 0, "hidden": true, "autonomy_mult": {"tag:fire": 1.4}},
    "wx_snowy": {"label": "Snow on the Ground", "mood": {}, "duration_min": 0, "hidden": true, "autonomy_mult": {"interaction:build_snowfolk": 1.5}},
    "wx_outside": {"label": "Outdoors", "mood": {}, "duration_min": 0, "hidden": true},
    "holiday_today": {"label": "Holiday", "mood": {}, "duration_min": 0, "hidden": true},
    "holiday_gifted": {"label": "Given a Gift", "mood": {"happy": 3}, "duration_min": 600, "thought": "What a thoughtful gift!"},
    "festive_home": {"label": "Festive Home", "mood": {"happy": 2}, "duration_min": 240, "thought": "The house looks so festive."}
  },
  "interactions": {
    "sunbathe": {"label": "Soak up the Sun", "kind": "super", "target": "object", "objects": ["garden_plot", "fishing_spot", "grill"], "tags": ["outdoor", "relax", "sun", "fun"],
      "duration_min": 40, "posture": "stand", "tests": [{"has_buff": "wx_clear"}, {"time_between": [9, 18]}, {"lacks_buff": "sunburn"}, {"stat_below": ["fun", 92]}],
      "per_min": {"fun": 0.35, "comfort": 0.1, "hygiene": -0.04}, "on_finish": [{"add_buff": "fresh_air", "chance": 0.6}, {"add_buff": "sunburn", "chance": 0.1}],
      "autonomous": true, "priority": "low", "advertises": {"fun": 1.3, "comfort": 0.7}, "thought": "What a lovely day to be outside.", "cooldown_min": 240},
    "rain_dance": {"label": "Dance in the Rain", "kind": "super", "target": "object", "objects": ["garden_plot", "fishing_spot", "grill"], "tags": ["outdoor", "fun", "rain"],
      "duration_min": 20, "posture": "stand", "tests": [{"has_buff": "wx_wet"}, {"lacks_buff": "wx_severe"}, {"lacks_buff": "wx_snowy"}, {"lacks_buff": "cold"}, {"stat_below": ["fun", 85]}],
      "per_min": {"fun": 0.7, "hygiene": -0.1}, "on_finish": [{"add_buff": "cheered_up"}, {"add_buff": "soaked"}, {"fire_event": "rain_dance"}],
      "autonomous": true, "priority": "low", "advertises": {"fun": 1.1}, "thought": "I can't resist a good puddle.", "cooldown_min": 300},
    "build_snowfolk": {"label": "Build a Snow Folk", "kind": "super", "target": "object", "objects": ["garden_plot", "fishing_spot", "grill"], "tags": ["outdoor", "fun", "snow", "creative"],
      "duration_min": 35, "posture": "stand", "tests": [{"has_buff": "wx_snowy"}, {"lacks_buff": "cold"}, {"lacks_buff": "wx_severe"}, {"stat_below": ["fun", 88]}],
      "per_min": {"fun": 0.55, "comfort": -0.06}, "on_finish": [{"add_buff": "cheered_up"}, {"fire_event": "built_snowfolk"}],
      "autonomous": true, "priority": "low", "advertises": {"fun": 1.3, "creative": 0.6}, "thought": "Snow! Let's build something.", "cooldown_min": 360},
    "give_holiday_gift": {"label": "Give a Holiday Gift", "kind": "social", "target": "folk", "duration_min": 8, "posture": "stand", "tags": ["social", "gift", "holiday"],
      "tests": [{"has_buff": "holiday_today"}], "target_tests": [{"posture_not": "lie"}],
      "per_min": {"social": 1.5}, "on_finish": [{"relationship_add": ["friendship", 5]}, {"target_add_buff": "holiday_gifted"}, {"add_buff": "proud"}, {"fire_event": "holiday_gift"}],
      "autonomous": true, "priority": "normal", "advertises": {"social": 1.8}, "thought": "I got you something.", "cooldown_min": 120}
  },
  "whims": {
    "wx_dance_in_rain": {"label": "Dance in the rain", "when": [{"has_buff": "wx_wet"}, {"lacks_buff": "wx_severe"}, {"lacks_buff": "wx_snowy"}, {"lacks_buff": "cold"}],
      "objective": {"type": "interaction", "ids": ["rain_dance"]}, "points": 25, "weight": 1.0, "expire_hours": 6},
    "wx_soak_sun": {"label": "Soak up some sun", "when": [{"has_buff": "wx_clear"}, {"time_between": [9, 17]}],
      "objective": {"type": "interaction", "ids": ["sunbathe"]}, "points": 20, "weight": 1.0, "expire_hours": 6},
    "wx_snowfolk": {"label": "Build a snow folk", "when": [{"has_buff": "wx_snowy"}, {"lacks_buff": "cold"}],
      "objective": {"type": "interaction", "ids": ["build_snowfolk"]}, "points": 30, "weight": 1.5, "expire_hours": 8},
    "wx_warm_up": {"label": "Warm up by the fire", "when": [{"has_buff": "cold"}],
      "objective": {"type": "interaction", "ids": ["warm_by_fire", "light_fireplace"]}, "points": 20, "weight": 2.0, "expire_hours": 5},
    "wx_dry_off": {"label": "Dry off with a shower", "when": [{"has_buff": "soaked"}],
      "objective": {"type": "interaction", "ids": ["take_shower", "take_bath"]}, "points": 15, "weight": 1.5, "expire_hours": 4}
  }
}
