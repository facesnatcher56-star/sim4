{
 "_doc": "Task 07: household chaos (home trouble). Burst pipe, overflowing toilet, a broken appliance, roaches. Handler: ChaosEvents.on_incident (scripts/systems/chaos_*.gd). Water damage and mould reuse the disaster lot records (DisasterState), so Scrub Mould and Call the Repairers also work here. Rates are per household per game year (28 days), Rare level; the roach rate is per MESSY household-year (exposure only counts messy homes). Far lots use the `statistical` blocks only.",
 "config": {
  "chaos": {
   "pipe": {"burst_cost": 40, "flow_cost_per_hour": 14, "flood_start": 0.15, "flood_per_hour": 0.06, "mould_after_hours": 10, "mould_start": 0.35,
            "mess_radius": 2, "mess": 2.5, "plumber_fee": 90, "diy_base": 0.3, "diy_per_level": 0.1, "diy_max": 0.95, "diy_fail_cost": 12},
   "overflow": {"burst_cost": 10, "flow_cost_per_hour": 4, "flood_start": 0.05, "flood_per_hour": 0.03, "mould_after_hours": 0, "stops_after_hours": 3,
                "mess_radius": 1, "mess": 1.5, "plumber_fee": 55, "diy_base": 0.4, "diy_per_level": 0.1, "diy_max": 0.95, "diy_fail_cost": 6},
   "appliance": {"objects": ["fridge", "stove", "washing_machine", "tv", "computer", "stereo", "microwave_cart", "coffee_maker"],
