   "jobs": {"plumber": [40, 90], "exterminator": [60, 120], "handy": [30, 70]},
   "counterplay_stages": {"_doc": "who may do the repair / call / paperwork interactions (also gated by tests in the interaction defs): never babies, toddlers or children", "default": ["teen", "adult", "elder"], "fix_leak": ["adult", "elder"], "shut_off_gas": ["adult", "elder"], "report_identity_theft": ["adult", "elder"]},
   "targets": {"burst_pipe": 0.18, "toilet_overflow": 0.35, "appliance_breakdown": 0.9, "roach_infestation": 1.2}
  }
 },
 "handlers": {
  "chaos_trouble": {"script": "res://scripts/systems/chaos_events.gd", "method": "on_incident"}
