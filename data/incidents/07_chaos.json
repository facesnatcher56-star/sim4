 "content": {
  "buffs": {
   "plumbing_trouble": {"label": "Water Everywhere", "mood": {"tense": 2, "uncomfortable": 1}, "duration_min": 0, "hidden": false, "thought": "Water is pouring out. I have to stop it!",
                        "autonomy_mult": {"interaction:fix_leak": 8.0}},
   "roaches_seen": {"label": "Roaches About", "mood": {"uncomfortable": 1}, "duration_min": 0, "thought": "Was that a roach?"},
   "pest_trouble": {"label": "Infested", "mood": {"uncomfortable": 3}, "duration_min": 0, "need_decay_mult": {"hygiene": 1.2},
                    "thought": "Roaches everywhere. This place is disgusting.", "autonomy_mult": {"interaction:set_roach_traps": 6.0}},
   "broken_things": {"label": "Things Broken", "mood": {"uncomfortable": 1}, "duration_min": 0, "thought": "Half the house is broken."},
   "pipes_checked": {"label": "Pipes Checked", "mood": {}, "duration_min": 7200, "hidden": true, "thought": "The pipes are in good shape."}
  },
  "interactions": {
   "fix_leak": {"label": "Stop the Leak", "kind": "super", "target": "object", "objects": ["sink", "toilet", "bathtub", "shower", "washing_machine"], "tags": ["chore", "repair", "skill"],
    "duration_min": 25, "posture": "stand", "tests": [{"age_stage_is": ["adult", "elder"]}, {"has_buff": "plumbing_trouble"}], "per_min": {"energy": -0.1, "hygiene": -0.2}, "skill_xp_per_min": {"handiness": 1.0},
    "works_when_broken": true, "on_finish": [{"fire_event": "fix_leak"}], "autonomous": true, "priority": "urgent", "advertises": {"tidy": 4.0}, "thought": "Shut the water off and fix the pipe."},
   "check_pipes": {"label": "Check the Pipes", "kind": "super", "target": "object", "objects": ["sink", "bathtub", "shower"], "tags": ["chore", "repair", "safety"],
    "duration_min": 10, "posture": "stand", "tests": [{"age_stage_is": ["teen", "adult", "elder"]}, {"lacks_buff": "pipes_checked"}], "per_min": {}, "skill_xp_per_min": {"handiness": 0.5},
    "on_finish": [{"add_buff": "pipes_checked"}, {"fire_event": "check_pipes"}], "autonomous": false, "priority": "normal", "advertises": {}, "thought": "Better check these pipes.", "cooldown_min": 2880},
   "call_plumber": {"label": "Call a Plumber", "kind": "super", "target": "object", "objects": ["mailbox"], "tags": ["repair", "chore"],
    "duration_min": 5, "posture": "stand", "tests": [{"age_stage_is": ["teen", "adult", "elder"]}, {"has_buff": "plumbing_trouble"}], "per_min": {}, "on_finish": [{"fire_event": "call_plumber"}],
    "autonomous": false, "priority": "normal", "advertises": {}, "thought": "We need a plumber."},
   "call_handyperson": {"label": "Call a Handyperson", "kind": "super", "target": "object", "objects": ["mailbox"], "tags": ["repair", "chore"],
    "duration_min": 5, "posture": "stand", "tests": [{"age_stage_is": ["teen", "adult", "elder"]}, {"has_buff": "broken_things"}], "per_min": {}, "on_finish": [{"fire_event": "call_handyperson"}],
    "autonomous": false, "priority": "normal", "advertises": {}, "thought": "Somebody needs to fix all this."},
   "call_exterminator": {"label": "Call the Exterminator", "kind": "super", "target": "object", "objects": ["mailbox"], "tags": ["repair", "chore"],
    "duration_min": 5, "posture": "stand", "tests": [{"age_stage_is": ["teen", "adult", "elder"]}, {"has_buff": "roaches_seen"}], "per_min": {}, "on_finish": [{"fire_event": "call_exterminator"}],
    "autonomous": false, "priority": "normal", "advertises": {}, "thought": "Time to call pest control."},
   "set_roach_traps": {"label": "Set Roach Traps", "kind": "super", "target": "object", "objects": ["trash_bin"], "tags": ["chore", "clean"],
    "duration_min": 6, "posture": "stand", "tests": [{"age_stage_is": ["teen", "adult", "elder"]}, {"has_buff": "roaches_seen"}, {"coins_at_least": 5}], "per_min": {}, "skill_xp_per_min": {"handiness": 0.3},
    "on_finish": [{"coins_add": -5}, {"fire_event": "set_roach_traps"}], "autonomous": true, "priority": "normal", "advertises": {"tidy": 2.5}, "thought": "I'll set some traps.", "cooldown_min": 480}
  },
  "object_interactions": {
   "mailbox": ["call_plumber", "call_handyperson", "call_exterminator"],
   "sink": ["fix_leak", "check_pipes"], "toilet": ["fix_leak"], "bathtub": ["fix_leak", "check_pipes"], "shower": ["fix_leak", "check_pipes"], "washing_machine": ["fix_leak"],
   "trash_bin": ["set_roach_traps"]
  }
 },
