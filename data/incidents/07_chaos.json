   "pests": {"start": 0.25, "seen": 0.01, "infested": 0.5, "swarm": 0.85, "grow_per_day": 0.1, "decay_per_day": 0.06, "messy_at": 2, "dirty_at": 6.0, "bin_full": 7.0,
