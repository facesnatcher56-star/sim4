class_name HouseBatch
extends RefCounted
## Generates the whole set (homes + venue alternates) with a shared "taken" registry so that no two lots, and none of the
## hand-made templates, share a floor plan or layout signature. Used by tools/gen_houses.gd and the tests.

## Returns {lots: {id: template}, reports: {id: stats}, failed: [id]}. `bump` is added to every spec seed.
static func generate(bump: int = 0, only: PackedStringArray = PackedStringArray()) -> Dictionary:
	var taken: Dictionary = {}
	var legacy := HouseSignature.legacy_templates()
	for id in legacy:
		taken[HouseSignature.plan_sig(legacy[id])] = id
		taken[HouseSignature.layout_sig(legacy[id])] = id
	var lots: Dictionary = {}
	var reports: Dictionary = {}
	var failed: Array = []
	for spec in HouseGenerator.specs().get("homes", []):
		var s: Dictionary = (spec as Dictionary).duplicate(true)
		if not only.is_empty() and str(s["id"]) not in only:
			continue
		s["seed"] = int(s["seed"]) + bump
		var r := HouseGenerator.make_home(s, taken)
		if not r.has("template"):
			failed.append(str(s["id"]))
			reports[str(s["id"])] = r["report"]
			continue
		_register(str(s["id"]), r, lots, reports, taken)
	var vr := HouseVenues.make_all(bump, taken, only)
	lots.merge(vr["lots"])
	reports.merge(vr["reports"])
	failed.append_array(vr["failed"])
	return {"lots": lots, "reports": reports, "failed": failed}


static func _register(id: String, r: Dictionary, lots: Dictionary, reports: Dictionary, taken: Dictionary) -> void:
	lots[id] = r["template"]
	reports[id] = r["report"]
	taken[HouseSignature.plan_sig(r["template"])] = id
	taken[HouseSignature.layout_sig(r["template"])] = id


## One lot per line so diffs stay readable.
static func write(lots: Dictionary, bump: int = 0) -> void:
	var ids: Array = lots.keys()
	ids.sort()
	var txt := '{\n"version": 1,\n"seed_bump": %d,\n"notes": "Generated by tools/gen_houses.gd (HouseGenerator). Same schema as lot_templates.json lots; see docs/HOUSE_LAYOUTS.md.",\n"lots": {\n' % bump
	var rows: Array = []
	for id in ids:
		rows.append('"%s": %s' % [id, JSON.stringify(lots[id])])
	txt += ",\n".join(rows) + "\n}\n}\n"
	var f := FileAccess.open(HouseGenerator.GENERATED_PATH, FileAccess.WRITE)
	f.store_string(txt)
	f.close()
