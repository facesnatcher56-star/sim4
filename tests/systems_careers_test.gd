extends RefCounted
## Careers: data shape, hiring, shifts (leave / return / pay), performance, promotion / demotion / firing, offers,
## skipping, school, retirement.

const K = preload("res://tests/systems_kit.gd")

func run() -> Array:
	var f: Array = []
	_data(f)
	_shift(f)
	_performance_and_promotion(f)
	_skips(f)
	_offers(f)
	_school(f)
	_retirement(f)
	_roundtrip(f)
	return f

func _data(f: Array) -> void:
	var w := K.setup()
	var c: Dictionary = SimEnv.data().get_table("careers")
	K.expect(f, (c["careers"] as Dictionary).size() >= 4, "need at least 4 careers")
	for cid in c["careers"]:
		var lv: Array = c["careers"][cid]["levels"]
		K.expect(f, lv.size() == 5, "%s needs 5 levels" % cid)
		var prev: int = 0
		for l in lv:
			K.expect(f, int(l["pay"]) > prev, "%s pay must rise with level" % cid)
			prev = int(l["pay"])
			K.expect(f, float(l["end"]) > float(l["start"]), "%s shift end after start" % cid)
	var a := K.make_folk(w, "Ann")
	K.expect(f, not bool(Careers.qualify(a, "coder", 2)["ok"]), "coder level 2 needs logic 2")
	a.add_skill_xp("logic", Folk.xp_for_level(2))
	K.expect(f, bool(Careers.qualify(a, "coder", 2)["ok"]), "logic 2 qualifies for level 2")
	K.expect(f, not Careers.hire(a, "astronaut"), "unknown career refused")
	K.expect(f, Careers.hire(a, "coder", 1) and a.has_job() and a.work_start == 9.0 and a.work_end == 17.0, "hire sets the folk's shift hours")
	K.expect(f, Careers.title_of(int(a.id)) == "Help Desk", "level 1 coder is Help Desk")
	K.teardown()

func _shift(f: Array) -> void:
	var w := K.setup()
	var a := K.make_folk(w, "Ann", ["workaholic"])
	var dir = K.director()
	WorldIface.coins[1] = 0
	Careers.hire(a, "coder", 1)
	K.set_time(1, 8, 50)       # Monday
	K.run(dir, 5)
	K.expect(f, not SysUtil.is_away(a), "not away before the shift starts (08:55)")
	K.run(dir, 10)
	K.expect(f, K.count_events("left_for_work") == 1, "left_for_work must fire at 09:00, got %d" % K.count_events("left_for_work"))
	K.expect(f, SysUtil.is_away(a) and a.has_buff("away"), "folk is away (meta + buff) while at work")
	var ev: Dictionary = K.last_event("left_for_work")
	K.expect(f, int(ev.get("folk_id", -1)) == a.id, "left_for_work carries the folk id")
	K.run(dir, 60)
	K.expect(f, SysUtil.is_away(a), "still at work at 10:15")
	# another folk cannot chat with someone who is away
	var b := K.make_folk(w, "Bo")
	var chat := Interaction.create("chat", b, a.id, true)
	K.expect(f, chat != null and not chat.can_run(b), "cannot target an away folk with a social interaction")
	K.run(dir, 8 * 60)
	K.expect(f, not SysUtil.is_away(a), "back home after 17:00")
	K.expect(f, K.count_events("returned_from_work") == 1, "returned_from_work must fire once")
	var r: Dictionary = K.last_event("returned_from_work")
	var pay: int = int(r.get("pay", 0))
	K.expect(f, pay > 8 * 16 * 0.7 and pay < 8 * 16 * 1.3, "pay should be about 8h x 16, got %d" % pay)
	K.expect(f, WorldIface.get_coins(1) >= pay, "wages land in the household funds")
	K.expect(f, K.has_note("earned"), "pay notification expected")
	K.expect(f, not bool(r.get("skipped", true)), "completed shift is not 'skipped'")
	# weekend: no shift on day 6 (weekday 5)
	var before: int = K.count_events("left_for_work")
	K.set_time(6, 8, 50)
	K.run(dir, 30)
	K.expect(f, K.count_events("left_for_work") == before, "no shift on the weekend")
	K.teardown()

func _performance_and_promotion(f: Array) -> void:
	var w := K.setup()
	var a := K.make_folk(w, "Ann")
	Careers.hire(a, "coder", 1)
	var fid: int = int(a.id)
	var p0: float = Careers.performance_of(fid)
	Careers.on_interaction(fid, "work_computer", true)
	K.expect(f, Careers.performance_of(fid) > p0, "work_computer at home raises performance")
	var p1: float = Careers.performance_of(fid)
	Careers.on_interaction(fid, "paint_canvas", true)
	K.expect(f, Careers.performance_of(fid) == p1, "irrelevant hooks do nothing for a coder")
	# promotion blocked without the skill
	Careers.add_performance(fid, 200.0)
	K.expect(f, Careers.level_of(fid) == 1 and Careers.performance_of(fid) >= 100.0, "capped at 100 without logic 2")
	K.expect(f, K.has_note("needs"), "tells the player what is missing")
	a.add_skill_xp("logic", Folk.xp_for_level(2))
	Careers.add_performance(fid, 1.0)
	K.expect(f, Careers.level_of(fid) == 2, "promoted once logic 2 is reached")
	K.expect(f, a.work_start == 9.0 and Careers.title_of(fid) == "Junior Dev", "title and schedule follow the level")
	K.expect(f, K.count_events("promoted") == 1, "promoted event fired")
	K.expect(f, Careers.performance_of(fid) == 40.0, "performance resets after promotion")
	# demotion and firing
	Careers.add_performance(fid, -100.0, true)
	K.expect(f, Careers.level_of(fid) == 1, "zero performance demotes")
	Careers.add_performance(fid, -100.0, true)
	K.expect(f, not Careers.has_job(fid) and not a.has_job() and K.count_events("fired") == 1, "zero performance at level 1 gets you fired")
	# shift_gain responds to mood / skills
	var b := K.make_folk(w, "Bo", ["gamer"])
	Careers.hire(b, "coder", 1)
	var g_base: float = Careers.shift_gain(b, "coder", 1)
	b.add_buff("focused_flow")
	b.add_buff("proud")
	var g_buff: float = Careers.shift_gain(b, "coder", 1)
	K.expect(f, g_buff > g_base, "good buffs raise shift performance (%.1f > %.1f)" % [g_buff, g_base])
	b.add_buff("starving")
	K.expect(f, Careers.shift_gain(b, "coder", 1) < g_buff, "starving lowers shift performance")
	K.teardown()

func _skips(f: Array) -> void:
	var w := K.setup()
	var a := K.make_folk(w, "Ann")
	var dir = K.director()
	Careers.hire(a, "coder", 1)
	var p0: float = Careers.performance_of(int(a.id))
	Careers.skip_work_today(int(a.id))
	K.set_time(1, 8, 55)
	K.run(dir, 10)
	K.expect(f, K.count_events("left_for_work") == 0 and K.count_events("skipped_work") == 1, "chosen skip: stays home, event fired")
	K.expect(f, Careers.performance_of(int(a.id)) == p0 - 15.0, "skip costs 15 performance")
	# critical need -> sick day, smaller penalty
	var b := K.make_folk(w, "Bo")
	Careers.hire(b, "coder", 1)
	(b.needs["hunger"] as Stat).set_value(-90.0)
	var pb: float = Careers.performance_of(int(b.id))
	K.set_time(2, 8, 55)
	K.run(dir, 10)
	K.expect(f, Careers.performance_of(int(b.id)) == pb - 8.0 and not SysUtil.is_away(b), "critical need: calls in sick, -8 performance")
	# a player-queued interaction is allowed to win, with a penalty
	var c := K.make_folk(w, "Cy", [], 1, Vector2i(14, 14))
	var tv = w.add_object("tv", Vector2i(14, 15))
	Careers.hire(c, "coder", 1)
	var pc: float = Careers.performance_of(int(c.id))
	K.set_time(3, 8, 40)
	dir.command(c.id, "watch_tv", tv.id)
	K.run(dir, 25)
	K.expect(f, not SysUtil.is_away(c) and Careers.performance_of(int(c.id)) < pc, "player command beats work, with a penalty")
	# going to work then being pulled out by an emergency / player counts as a skip
	var d := K.make_folk(w, "Di", [], 1, Vector2i(16, 16))
	Careers.hire(d, "coder", 1)
	K.set_time(4, 8, 59)
	K.run(dir, 5)
	K.expect(f, SysUtil.is_away(d), "Di is at work")
	var pd: float = Careers.performance_of(int(d.id))
	var pay_before: int = WorldIface.get_coins(1)
	Away.recall(int(d.id), "player")
	K.run(dir, 2)
	K.expect(f, not SysUtil.is_away(d), "recalled folk returns")
	K.expect(f, Careers.performance_of(int(d.id)) < pd, "leaving work early costs performance")
	K.expect(f, WorldIface.get_coins(1) >= pay_before, "partial pay for the time worked")
	K.teardown()

func _offers(f: Array) -> void:
	var w := K.setup()
	var a := K.make_folk(w, "Ann", ["creative"])
	var o: Dictionary = Careers.make_offer(a)
	K.expect(f, not o.is_empty() and Careers.pending_offer(int(a.id)).has("career"), "offer is stored")
	K.expect(f, K.has_note("job offer"), "offers are announced through notifications")
	K.expect(f, K.last_event("job_offer").has("career"), "job_offer game event")
	K.expect(f, Careers.accept_offer(int(a.id)) and Careers.has_job(int(a.id)), "accepting hires the folk")
	K.expect(f, Careers.pending_offer(int(a.id)).is_empty(), "offer consumed")
	# decline and expiry
	var b := K.make_folk(w, "Bo")
	Careers.make_offer(b, "cook", 1)
	Careers.decline_offer(int(b.id))
	K.expect(f, Careers.pending_offer(int(b.id)).is_empty(), "declined offers vanish")
	Careers.make_offer(b, "cook", 1)
	K.set_time(10, 8)
	Careers.on_day(10)
	K.expect(f, Careers.pending_offer(int(b.id)).is_empty() or Careers.has_job(int(b.id)), "stale offers expire")
	# the computer's "Look for Jobs" action closes the loop
	var c := K.make_folk(w, "Cy")
	var pc = w.add_object("computer", Vector2i(20, 20))
	c.tile = Vector2i(20, 21)
	var dir = K.director()
	var ir := Interaction.create("apply_for_job", c, pc.id, true)
	K.expect(f, ir != null and ir.can_run(c), "apply_for_job is available to the unemployed")
	c.enqueue(ir)
	K.run(dir, 25)
	K.expect(f, Careers.has_job(int(c.id)), "Look for Jobs ends with a new job")
	K.expect(f, not Interaction.create("apply_for_job", c, pc.id, true).can_run(c), "employed folk cannot apply again")
	K.teardown()

func _school(f: Array) -> void:
	var w := K.setup()
	var kid := K.make_folk(w, "Kid", [], 1, Vector2i(12, 12), "child")
	Aging.set_age_days(kid, 15.0)
	var dir = K.director()
	K.set_time(1, 6)
	Careers.on_day(1)
	K.expect(f, Careers.school.has(int(kid.id)), "children are enrolled in school")
	K.set_time(1, 8, 55)
	K.run(dir, 10)
	K.expect(f, SysUtil.is_away(kid) and K.count_events("left_for_school") == 1, "child leaves for school at 09:00")
	K.run(dir, 6 * 60 + 5)
	K.expect(f, not SysUtil.is_away(kid) and K.count_events("returned_from_school") == 1, "child returns after school")
	var ev: Dictionary = K.last_event("returned_from_school")
	K.expect(f, str(ev.get("letter", "")) in ["A", "B", "C", "D", "F"], "grade letter reported")
	var g0: float = Careers.grade_of(int(kid.id))
	Careers.on_interaction(int(kid.id), "read_book", true)
	K.expect(f, Careers.grade_of(int(kid.id)) > g0, "reading raises the grade")
	K.expect(f, Careers.info_for(int(kid.id)).get("student", false), "info_for reports a student")
	K.teardown()

func _retirement(f: Array) -> void:
	var w := K.setup()
	var a := K.make_folk(w, "Old", [], 1, Vector2i(12, 12), "elder")
	Aging.set_age_days(a, 150.0)
	Careers.hire(a, "painter", 3)
	WorldIface.coins[1] = 0
	Careers.on_day(5)
	K.expect(f, Careers.retired.has(int(a.id)) and not a.has_job(), "elders retire")
	K.expect(f, K.count_events("retired") == 1 and K.has_note("retired"), "retirement is announced")
	Careers.on_day(6)
	K.expect(f, WorldIface.get_coins(1) > 0, "retired folk receive a daily pension")
	K.expect(f, not Careers.hire(a, "cook"), "retired folk are not re-hired")
	K.teardown()

func _roundtrip(f: Array) -> void:
	var w := K.setup()
	var a := K.make_folk(w, "Ann")
	Careers.hire(a, "cook", 2)
	Careers.add_performance(int(a.id), 12.0)
	Careers.make_offer(K.make_folk(w, "Bo"), "painter", 1)
	var d1: Dictionary = Careers.to_dict()
	var parsed: Variant = JSON.parse_string(JSON.stringify(d1))
	Careers.from_dict(parsed)
	var diffs: Array = []
	K.expect(f, K.deep_eq(d1, Careers.to_dict(), "careers", diffs), "careers roundtrip: %s" % str(diffs.slice(0, 5)))
	K.expect(f, a.work_start == 10.0, "schedule restored on load")
	K.teardown()
