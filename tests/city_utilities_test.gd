extends RefCounted
## Task 12.1: power, water and internet as zone networks; what a home does about it; boil notices; the bill split.

const K = preload("res://tests/systems_kit.gd")
const C = preload("res://tests/city_kit.gd")

func run() -> Array:
	var f: Array = []
	var w := C.setup()
	var h: Dictionary = C.home(w)
	var ada: Folk = h["ada"]
	var lamp = h["objs"]["lamp"]
	K.set_time(5, 10)
	var z: String = C.zone()
	WorldIface.state_set(lamp, "on", true)
	# --- power
	var o: Dictionary = UtilityEvents.start("power", z, "fault")
	K.expect(f, not o.is_empty() and Utilities.is_down("power", z), "a power fault takes the zone's power down")
	K.expect(f, ada.has_buff("power_out") and not bool(WorldIface.state_get(lamp, "on", true)), "the home goes dark")
	K.expect(f, K.has_note("power"), "the player is told in plain words")
	K.expect(f, not Utilities.is_down("power", "nowhere"), "other zones are untouched")
	var lines: Array = Utilities.status_lines(1)
	K.expect(f, str(lines[0]).find("Electricity: off") == 0 and str(lines[0]).find("Back in about") > 0, "status says what is off and for how long (%s)" % str(lines[0]))
	C.run_hours(int(ceil(float(Utilities.minutes_left(o)) / 60.0)) + 1)
	K.expect(f, not Utilities.is_down("power", z) and not ada.has_buff("power_out") and bool(WorldIface.state_get(lamp, "on", false)), "power returns: marker gone, lamp back on")
	K.expect(f, Utilities.history.size() == 1 and int(Utilities.stats.get("outages", 0)) == 1, "the outage is kept in the history")
	# generator and solar panels
	var gen = w.add_object("generator", Vector2i(34, 34))
	Economy.refresh_objects()
	UtilityHomes.forget_cache()
	WorldIface.state_set(gen, "fuel", 2.0)
	UtilityEvents.start("power", z, "storm", {"hours": 30})
	K.expect(f, not ada.has_buff("power_out"), "a generator keeps the lights on")
	C.run_hours(3)
	K.expect(f, float(WorldIface.state_get(gen, "fuel", 5.0)) <= 0.0 and ada.has_buff("power_out"), "the fuel runs out and the power is off after all")
	Utilities.finish(Utilities.outage_of("power", z))
	w.objects.erase(gen.id)
	Economy.refresh_objects()
	var sol = w.add_object("solar_panel", Vector2i(34, 36))
	Economy.refresh_objects()
	UtilityHomes.forget_cache()
	K.set_time(6, 12)
	UtilityEvents.start("power", z, "storm", {"hours": 30})
	K.expect(f, not ada.has_buff("power_out"), "solar panels keep the home powered in daylight")
	K.set_time(6, 23)
	C.run_hours(1)
	K.expect(f, ada.has_buff("power_out"), "but not at night")
	Utilities.finish(Utilities.outage_of("power", z))
	w.objects.erase(sol.id)
	Economy.refresh_objects()
	UtilityHomes.forget_cache()
	K.expect(f, not ada.has_buff("power_out"), "back to normal")
	# --- phone and internet
	var inter: Dictionary = SimEnv.data().interactions()
	for key in ["needs_water", "needs_signal", "needs_online"]:
		for iid in Utilities.cfg().get(key, []):
			K.expect(f, inter.has(iid), "data/city.json %s names a real interaction: %s" % [key, iid])
	K.expect(f, (inter["research_online"]["tests"] as Array).has({"lacks_buff": "offline"}), "online things need the internet")
	K.expect(f, (inter["call_plumber"]["tests"] as Array).has({"lacks_buff": "no_signal"}), "phone calls need a line")
	UtilityEvents.start("internet", z, "line_fault")
	K.expect(f, ada.has_buff("no_signal") and ada.has_buff("offline"), "a cable fault cuts phone and internet")
	K.expect(f, not UtilityHomes.has("internet", 1) and Utilities.status_lines(1)[2].find("Phone and internet: off") == 0, "status shows it")
	Utilities.finish(Utilities.outage_of("internet", z))
	K.expect(f, not ada.has_buff("no_signal") and not ada.has_buff("offline"), "service returns")
	UtilityEvents.start("power", z, "fault")
	K.expect(f, ada.has_buff("offline") and not ada.has_buff("no_signal"), "no power: the router is off but the phone line works")
	Utilities.finish(Utilities.outage_of("power", z))
	Economy.missed[1] = 1
	UtilityHomes.refresh(1)
	K.expect(f, ada.has_buff("offline") and ada.has_buff("no_signal"), "overdue bills: the phone and internet company cut the line")
	Economy.missed[1] = 0
	UtilityHomes.refresh(1)
	K.expect(f, not ada.has_buff("offline"), "paid up: reconnected")
	# --- water: tank, well
	UtilityEvents.start("water", z, "burst_main")
	K.expect(f, ada.has_buff("no_water"), "a burst main leaves the taps dry")
	K.expect(f, (inter["take_shower"]["tests"] as Array).has({"lacks_buff": "no_water"}), "showers need water")
	Utilities.finish(Utilities.outage_of("water", z))
	K.expect(f, not ada.has_buff("no_water"), "water returns")
	var tank = w.add_object("water_tank", Vector2i(34, 38))
	Economy.refresh_objects()
	UtilityHomes.forget_cache()
	var wo: Dictionary = UtilityEvents.start("water", z, "pump_fault")
	wo["end"] = SysUtil.now() + 60 * 80
	K.expect(f, not ada.has_buff("no_water"), "a water tank carries the home through the first hours")
	C.run_hours(40)
	K.expect(f, Utilities.is_down("water", z) and ada.has_buff("no_water"), "an empty tank does not (reserve %s)" % str(Utilities.reserve))
	Utilities.finish(Utilities.outage_of("water", z))
	w.objects.erase(tank.id)
	var well = w.add_object("well", Vector2i(34, 40))
	Economy.refresh_objects()
	UtilityHomes.forget_cache()
	UtilityEvents.start("water", z, "burst_main", {"hours": 30})
	K.expect(f, not ada.has_buff("no_water"), "a well does not care about the mains")
	UtilityEvents.start("power", z, "fault", {"hours": 30})
	K.expect(f, ada.has_buff("no_water"), "a well pump needs power")
	Utilities.finish(Utilities.outage_of("power", z))
	Utilities.finish(Utilities.outage_of("water", z))
	# --- boil notice
	Utilities.start_boil(z, 2)
	K.expect(f, Utilities.boil_active(z) and UtilityHomes.has_well(1) and not ada.has_buff("boil_notice"), "a well household is not bothered by the boil notice")
	w.objects.erase(well.id)
	Economy.refresh_objects()
	UtilityHomes.forget_cache()
	UtilityHomes.refresh(1)
	K.expect(f, ada.has_buff("boil_notice") and not UtilityHomes.water_safe(1), "boil notice marks the people who must boil their water")
	var ill_before: int = int(Utilities.stats.get("boil_ill", 0))
	Utilities.cfg()["boil"]["ill_chance_per_day"] = 1.0
	Utilities.on_day(5)
	K.expect(f, int(Utilities.stats.get("boil_ill", 0)) > ill_before and Health.is_ill(ada), "drinking unboiled water can make people ill")
	Utilities.cfg()["boil"]["ill_chance_per_day"] = 0.0
	Utilities.on_event("boil_water", {"folk_id": ada.id})
	K.expect(f, UtilityHomes.water_safe(1) and not ada.has_buff("boil_notice"), "boiling a batch makes it safe")
	K.set_time(14, 12)
	Utilities.on_day(14)
	K.expect(f, not Utilities.boil_active(z) and K.has_note("safe again"), "the notice ends and the player is told")
	# --- report an outage
	var o2: Dictionary = UtilityEvents.start("power", z, "storm")
	var left0: int = Utilities.minutes_left(o2)
	Utilities.on_event("report_outage", {"folk_id": ada.id})
	K.expect(f, Utilities.minutes_left(o2) < left0 and Utilities.minutes_left(o2) >= left0 * 3 / 4 - 1, "reporting it makes crews quicker, once")
	K.expect(f, not Utilities.report(o2), "a second report does nothing")
	Utilities.finish(o2)
	# --- far townie lots: a one-line record, no objects needed
	var ev_before: int = (DisasterState.lots.get("town:1", {"events": []})["events"] as Array).size()
	UtilityEvents.start("power", CityState.zone_of_town_lot(1), "fault")
	K.expect(f, (DisasterState.lots["town:1"]["events"] as Array).size() > ev_before, "a townie lot gets a short lot event line")
	# --- bills split by utility
	Utilities.reset()
	K.set_time(10, 8)
	Economy.usage[1] = 20.0
	UtilityBills.note(1, "take_shower")
	var p0: Dictionary = UtilityBills.parts(1)
	K.expect(f, int(round(UtilityBills.total(p0))) == Economy.compute_bill(1), "the parts add up to the bill")
	K.expect(f, float(p0["power"]) > 0.0 and float(p0["water"]) > 0.0 and float(p0["internet"]) > 0.0 and float(p0["rates"]) > 0.0, "every utility has its part")
	var bill: Dictionary = Economy.issue_bill(1)
	var psum: int = 0
	for k in (bill["parts"] as Dictionary):
		psum += int(bill["parts"][k])
	K.expect(f, psum == int(bill["amount"]) and K.has_note("electricity"), "the issued bill carries whole-number parts and the toast names them (%s)" % str(bill["parts"]))
	p0 = UtilityBills.parts(1)
	w.add_object("solar_panel", Vector2i(34, 42))
	w.add_object("water_tank", Vector2i(34, 44))
	Economy.refresh_objects()
	UtilityHomes.forget_cache()
	var p1: Dictionary = UtilityBills.parts(1)
	K.expect(f, float(p1["power"]) / float(p1["internet"]) < 0.8 * float(p0["power"]) / float(p0["internet"]) and float(p1["water"]) / float(p1["internet"]) < 0.9 * float(p0["water"]) / float(p0["internet"]), "solar panels and a tank cut their own parts only (%s vs %s)" % [str(p0), str(p1)])
	# --- save and load
	Utilities.begin("power", z, 3.0, "storm", {"silent": true})
	Utilities.start_boil("west", 3)
	var before: String = JSON.stringify(CityState.to_dict())
	CityState.from_dict(JSON.parse_string(before))
	K.expect(f, JSON.stringify(CityState.to_dict()) == before, "the city block survives a JSON round trip unchanged")
	K.teardown()
	return f
